#Main menu
menuconfig LED_SUBSYSTEM
    bool "Led Subsystem"
    default y

#If selection menu LED_SUBSYSTEM, can see the options, submenu
if LED_SUBSYSTEM

    #Options of blinking led
    choice
        prompt "Led blink sleep time"
        default LED_BLINK_SLEEP_1000MS

    config LED_BLINK_SLEEP_250MS
        bool "250ms (Fast)"
    config LED_BLINK_SLEEP_500MS
        bool "500ms (Normal)"
    config LED_BLINK_SLEEP_1000MS
        bool "1s (Medium)"
    config LED_BLINK_SLEEP_2000MS
        bool "2s (Slow)"

    endchoice #end choc

    config LED_BLINK_SLEEP_TIME
        int 
        depends on LED_SUBSYSTEM
        default 250 if LED_BLINK_SLEEP_250MS
        default 1000 if LED_BLINK_SLEEP_1000MS
        default 2000 if LED_BLINK_SLEEP_2000MS
        default 500
        help
            Sleep time to period.

    menuconfig ADVANCED_SETTINGS
        bool "Advanced Led Settings"
        default n

    if ADVANCED_SETTINGS

        config LED_BRIGHTNESS
            int "LED Brightness (0-100)"
            depends on ADVANCED_SETTINGS
            default 100
            range 0 100
            help
                Led % brghtness.

        config LED_FADE
            int "LED fade duration (ms)"
            depends on ADVANCED_SETTINGS
            default 500
            range 0 5000
            help
                Led fade duration.

        menu "Expert Settings"
            visible if ADVANCED_SETTINGS
            depends on ADVANCED_SETTINGS

        config LED_DEBUG
            bool "Enable LED debugging"

        config BLINK_PATTERN
            bool "Custom blink pattern"

        endmenu

    endif

endif

source "Kconfig.zephyr"

#Baic menu
#menu "LED Settings"

#config LED_BRIGHTNESS
#    int "Led brightness (0-100)"
#
#endmenu